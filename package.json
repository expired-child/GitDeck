{
  "name": "idea-git",
  "displayName": "IDEA Git",
  "description": "IDEA-style Git workflow for VS Code: Local Changes, Commit, Git Log with Commit Graph, Branches, History and remote operations.",
  "version": "0.1.0",
  "publisher": "idea-git",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "activationEvents": [
    "workspaceContains:.git",
    "onView:ideaGit.gitView",
    "onView:ideaGit.logView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ideaGit.open",
        "title": "Open Git",
        "category": "IDEA Git"
      },
      {
        "command": "ideaGit.openCommit",
        "title": "Open Commit",
        "category": "IDEA Git"
      },
      {
        "command": "ideaGit.openLog",
        "title": "Open Log",
        "category": "IDEA Git"
      },
      {
        "command": "ideaGit.refresh",
        "title": "Refresh",
        "category": "IDEA Git",
        "icon": "$(refresh)"
      },
      {
        "command": "ideaGit.commit",
        "title": "Commit",
        "category": "IDEA Git"
      },
      {
        "command": "ideaGit.push",
        "title": "Push",
        "category": "IDEA Git"
      },
      {
        "command": "ideaGit.pull",
        "title": "Pull",
        "category": "IDEA Git"
      },
      {
        "command": "ideaGit.fetch",
        "title": "Fetch",
        "category": "IDEA Git"
      },
      {
        "command": "ideaGit.newBranch",
        "title": "New Branch",
        "category": "IDEA Git",
        "icon": "$(add)"
      },
      {
        "command": "ideaGit.checkoutBranch",
        "title": "Checkout Branch",
        "category": "IDEA Git"
      },
      {
        "command": "ideaGit.mergeBranch",
        "title": "Merge Branch",
        "category": "IDEA Git"
      },
      {
        "command": "ideaGit.rebaseBranch",
        "title": "Rebase Branch",
        "category": "IDEA Git"
      },
      {
        "command": "ideaGit.branchPicker",
        "title": "Branch Picker",
        "category": "IDEA Git"
      },
      {
        "command": "ideaGit.showFileHistory",
        "title": "Show File History",
        "category": "IDEA Git"
      },
      {
        "command": "ideaGit.showBlame",
        "title": "Toggle Blame",
        "category": "IDEA Git"
      },
      {
        "command": "ideaGit.stashChanges",
        "title": "Stash Changes",
        "category": "IDEA Git"
      },
      {
        "command": "ideaGit.unstash",
        "title": "Unstash Changes",
        "category": "IDEA Git"
      },
      {
        "command": "ideaGit.initRepository",
        "title": "Initialize Repository",
        "category": "IDEA Git"
      },
      {
        "command": "ideaGit.selectRepository",
        "title": "Select Repository",
        "category": "IDEA Git"
      },
      {
        "command": "ideaGit.updateLog",
        "title": "更新远端提交日志（不修改代码）",
        "category": "IDEA Git",
        "icon": "$(cloud-download)"
      }
    ],
    "keybindings": [
      {
        "command": "ideaGit.openLog",
        "key": "alt+9"
      },
      {
        "command": "ideaGit.openCommit",
        "key": "ctrl+alt+c"
      },
      {
        "command": "ideaGit.push",
        "key": "ctrl+alt+shift+k"
      },
      {
        "command": "ideaGit.openCommit",
        "key": "alt+0"
      }
    ],
    "submenus": [
      {
        "id": "ideaGit.contextMenu",
        "label": "Git"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "ideaGit.contextMenu",
          "group": "9_ideagit"
        }
      ],
      "explorer/context": [
        {
          "submenu": "ideaGit.contextMenu",
          "group": "9_ideagit"
        }
      ],
      "ideaGit.contextMenu": [
        {
          "command": "ideaGit.showFileHistory",
          "group": "1_history"
        },
        {
          "command": "ideaGit.showBlame",
          "group": "1_history"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ideaGit",
          "title": "Commit",
          "icon": "media/icon.svg"
        }
      ],
      "panel": [
        {
          "id": "ideaGit-log",
          "title": "Git",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ideaGit": [
        {
          "type": "webview",
          "id": "ideaGit.gitView",
          "name": "Commit"
        }
      ],
      "ideaGit-log": [
        {
          "type": "webview",
          "id": "ideaGit.logView",
          "name": "Git Log"
        }
      ]
    },
    "configuration": {
      "title": "IDEA Git",
      "properties": {
        "ideaGit.defaultView": {
          "type": "string",
          "enum": [
            "changes",
            "log",
            "history"
          ],
          "default": "changes",
          "description": "Default active view when the Git panel opens."
        },
        "ideaGit.commitMode": {
          "type": "string",
          "enum": [
            "simple",
            "staging"
          ],
          "default": "simple",
          "description": "Commit mode: simple (checkbox selection, IDEA style) or staging (explicit stage/unstage)."
        },
        "ideaGit.log.pageSize": {
          "type": "number",
          "enum": [
            100,
            200,
            500
          ],
          "default": 200,
          "description": "Number of commits loaded per page in the Git Log."
        },
        "ideaGit.log.showGraph": {
          "type": "boolean",
          "default": true,
          "description": "Show the commit graph in the Git Log."
        },
        "ideaGit.log.showRemoteBranches": {
          "type": "boolean",
          "default": true,
          "description": "Include remote branches in the Git Log."
        },
        "ideaGit.commitMessageHistorySize": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 100,
          "description": "Number of recent commit messages kept in history."
        },
        "ideaGit.pullMode": {
          "type": "string",
          "enum": [
            "merge",
            "rebase"
          ],
          "default": "merge",
          "description": "Default pull strategy."
        },
        "ideaGit.confirm.discardChanges": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before discarding changes."
        },
        "ideaGit.confirm.forcePush": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before force pushing (always uses --force-with-lease)."
        },
        "ideaGit.confirm.hardReset": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before a hard reset."
        },
        "ideaGit.remoteLog.autoRefreshInterval": {
          "type": "number",
          "default": 180,
          "minimum": 0,
          "description": "检查当前分支远端提交的间隔（秒，最短 30 秒），0 关闭。仅在窗口获得焦点时获取提交信息，不拉取或合并代码。"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -p ./ -w",
    "build:webview": "vite build",
    "watch:webview": "vite build --watch",
    "build": "npm run compile && npm run build:webview",
    "typecheck": "tsc -p ./ --noEmit && tsc -p webview/tsconfig.json --noEmit",
    "lint": "eslint src webview/src",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.9.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.4"
  }
}
